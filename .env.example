# All variables are optional. Defaults live in lib/site.ts.

# Public site URL used for canonical links, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://videelegal.com

# Formspree form endpoint, e.g. https://formspree.io/f/abcdwxyz
# Leave empty to fall back to opening the visitor's email client.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Contact details (override the defaults in lib/site.ts)
NEXT_PUBLIC_CONTACT_EMAIL=info@videelegal.com
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/146645610/
# WhatsApp Business number in international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=918618744390
